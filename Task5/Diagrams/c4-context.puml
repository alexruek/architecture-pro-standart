@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Диаграмма контекста (C4 Level 1) — Подача заявки на кредит онлайн

Person(new_client, "Новый клиент", "Подает заявку на кредит через сайт")
Person(existing_client, "Существующий клиент", "Подает заявку через интернет-банк;\nвидит предодобренное предложение")
Person(branch_employee, "Сотрудник отделения", "Работает с заявками клиентов в АБС")
Person(credit_manager, "Сотрудник отдела\nкредитования", "Обрабатывает заявки\nв Кредитном конвейере")

System(site, "Сайт", "PHP / React.js.\nПрием заявок новых клиентов")
System(ibank, "Интернет-банк", "ASP.NET MVC 4.5 / .NET 4.5 / MS SQL.\nПрием заявок; предодобренные предложения")
System(loan_svc, "Loan Application Service", "Новый сервис. Java Spring Boot / PostgreSQL.\nЕдиный реестр онлайн-заявок;\nпредодобренные предложения")
System(batch_svc, "Pre-Approval Batch", "Java Spring Batch.\nНочной расчет предодобренных предложений\nна основе Scoring Cache — без нагрузки на скоринг")
System(conveyor, "Кредитный конвейер", "Camunda / Oracle.\nОбработка заявок сотрудниками")
System(abs, "АБС", "Delphi / Oracle / PL-SQL.\nКлиентская база; заявки из отделений")

System_Ext(scoring, "Система скоринга", "Python / Flask / PostgreSQL.\nКредитный скоринг клиентов")
System_Ext(bki, "БКИ", "Внешний REST API.\nИстория кредитов новых клиентов")
System_Ext(sms_gw, "СМС-шлюз / Телеком-оператор", "Доставка СМС клиентам")

Rel(new_client, site, "Смотрит условия, подает заявку (UC-1)")
Rel(existing_client, ibank, "Смотрит предложение, подает заявку (UC-2, UC-3)")
Rel(branch_employee, abs, "Работает с заявкой клиента (UC-4)")
Rel(credit_manager, conveyor, "Обрабатывает заявки (UC-6)")

Rel(site, loan_svc, "Передает заявку нового клиента (UC-1)", "REST / HTTPS")
Rel(ibank, loan_svc, "Передает заявку; получает предложения (UC-2, UC-3)", "REST / HTTPS")
Rel(loan_svc, conveyor, "Передает онлайн-заявки минуя АБС (UC-5)", "Kafka")
Rel(loan_svc, sms_gw, "Отправляет СМС об изменении статуса (UC-7)", "REST")
Rel(loan_svc, bki, "Запрашивает данные нового клиента (UC-1)", "REST / HTTPS")
Rel(batch_svc, abs, "Читает клиентскую базу ночью (UC-8)", "JDBC")
Rel(batch_svc, scoring, "Читает кэш скоринга — без новых вызовов (UC-8)", "JDBC / DB read")
Rel(batch_svc, loan_svc, "Сохраняет предодобренные предложения (UC-8)", "REST / JDBC")
Rel(abs, conveyor, "Заявки из отделений раз в сутки (UC-4)", "БД / batch")
Rel(conveyor, scoring, "Вызывает скоринг при обработке заявки (UC-6)", "REST API")

@enduml